# Sofnade storefront API — environment variables (set these in Vercel:
# Project → Settings → Environment Variables). Everything here is OPTIONAL:
# with nothing set, the store runs in "test mode" and order capture/notify is
# skipped gracefully. Add a group to turn that capability on.

# --- Payments (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: force a currency for test mode (a standard India account often only
# accepts INR). Leave unset to charge in the order currency (SGD).
# RAZORPAY_CURRENCY=INR

# --- Order storage (Supabase) ----------------------------------------------
# Run db/orders.sql once in your Supabase project, then set these. Use the
# SERVICE ROLE key (server-only — never ship it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff mirror (Notion) -------------------------------------------------
# Create an internal integration, share your orders database with it, and paste
# the database id. Each paid order becomes a new page.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Receipts (Resend) -----------------------------------------------------
# RECEIPT_FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=
RECEIPT_FROM=orders@sofnade.com
# Optional: BCC every receipt to your team inbox.
# ORDER_NOTIFY_EMAIL=hello@sofnade.com
# Optional: WhatsApp number for the "Message us" button in receipts (digits only,
# no '+'). Defaults to 6589309756 (the storefront button uses js/common.js).
# SUPPORT_WHATSAPP=6589309756

# --- Staff admin dashboard (/admin.html) -----------------------------------
# A shared password staff type to view/edit orders. Use a long random value.
# Without it, the admin API returns 503 and the dashboard can't be used.
ADMIN_PASSWORD=

# --- CMS (Sanity) ----------------------------------------------------------
# The server-side reader defaults to the same public project as the browser
# (mkxfjwwf / production); only set these to override or read a private dataset.
# SANITY_PROJECT_ID=mkxfjwwf
# SANITY_DATASET=production
# SANITY_READ_TOKEN=

# --- Xero (accounting sync) ------------------------------------------------
# Custom Connection credentials from developer.xero.com. When set, every order
# is mirrored into Xero as an ACCREC invoice (paid orders also get a payment
# recorded). Unset = the sync silently no-ops.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# XERO_SALES_ACCOUNT=200        # revenue account code
# XERO_PAYMENT_ACCOUNT=090      # bank/clearing account ("Enable payments" ticked)
# XERO_TAX_TYPE=                # optional per-line TaxType; default = account's tax rate
# XERO_DUE_DAYS=7               # due-date offset for unpaid (Corporate Booking) invoices
