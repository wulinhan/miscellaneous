# Sofnade storefront API — environment variables (set these in Vercel:
# Project → Settings → Environment Variables). Everything here is OPTIONAL:
# with nothing set, the store runs in "test mode" and order capture/notify is
# skipped gracefully. Add a group to turn that capability on.

# --- Payments (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: force a currency for test mode (a standard India account often only
# accepts INR). Leave unset to charge in the order currency (SGD).
# RAZORPAY_CURRENCY=INR

# --- Order storage (Supabase) ----------------------------------------------
# Run db/orders.sql once in your Supabase project, then set these. Use the
# SERVICE ROLE key (server-only — never ship it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff mirror (Notion) -------------------------------------------------
# Create an internal integration, share your orders database with it, and paste
# the database id. Each paid order becomes a new page.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Receipts (Resend) -----------------------------------------------------
# RECEIPT_FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=
RECEIPT_FROM=orders@sofnade.com
# Optional: BCC every receipt to your team inbox.
# ORDER_NOTIFY_EMAIL=hello@sofnade.com

# --- CMS (Sanity) ----------------------------------------------------------
# The server-side reader defaults to the same public project as the browser
# (mkxfjwwf / production); only set these to override or read a private dataset.
# SANITY_PROJECT_ID=mkxfjwwf
# SANITY_DATASET=production
# SANITY_READ_TOKEN=
